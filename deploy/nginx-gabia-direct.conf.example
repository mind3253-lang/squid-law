# SQUIDLAW Gabia reverse proxy (configure TLS certificate before public exposure).
# Static site and SKYNET APIs are served locally, without Vercel.
server {
    listen 80;
    server_name squidlaw.co.kr www.squidlaw.co.kr;
    server_tokens off;
    client_max_body_size 100m;
    add_header X-Content-Type-Options nosniff always;
    location = /admin/skynet-document-verify {
        rewrite ^ /api/skynet-document-verify break;
        proxy_pass http://127.0.0.1:3084;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }
    location = /admin/skynet-document-page-context {
        rewrite ^ /api/skynet-document-page-context break;
        proxy_pass http://127.0.0.1:3084;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }
    location = /admin/skynet-document-range {
        rewrite ^ /api/skynet-document-range break;
        proxy_pass http://127.0.0.1:3084;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }
    location = /admin/skynet-search-backfill {
        rewrite ^ /api/skynet-search-backfill break;
        proxy_pass http://127.0.0.1:3084;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }
    location = /admin/skynet-document-fulltext {
        rewrite ^ /api/skynet-document-fulltext break;
        proxy_pass http://127.0.0.1:3084;
        proxy_http_version 1.1;
