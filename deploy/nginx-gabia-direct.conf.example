    }
    location = /admin/skynet-document-review {
        rewrite ^ /api/skynet-document-review break;
        proxy_pass http://127.0.0.1:3084;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }
    location = /admin/skynet-document-context {
        rewrite ^ /api/skynet-document-context break;
        proxy_pass http://127.0.0.1:3084;
