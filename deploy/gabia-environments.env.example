# Gabia deployment environments (example only, no secrets)
# Keep all customer-facing services loopback-only until HTTPS, authentication,
# DB, storage, worker, backup and real E2E gates pass.
#
# PRODUCTION (future): /etc/squidlaw/production.env (0600, root-owned)
# STAGING: /etc/squidlaw/staging.env (0600, root-owned)
# Never reuse production database, blob path, session signing key, or payment keys.
SQUIDLAW_CUSTOMER_WEB_HOST=127.0.0.1
SQUIDLAW_CUSTOMER_WEB_PORT=3082
SQUIDLAW_CUSTOMER_WEB_PREVIEW=0
SQUIDLAW_GABIA_API_HOST=127.0.0.1
SQUIDLAW_GABIA_API_PORT=3083
SQUIDLAW_GABIA_API_PREVIEW=0
SQUIDLAW_GABIA_DB_LOCAL=1
# SQUIDLAW_GABIA_DATABASE_URL= (supply securely, never commit)
# SQUIDLAW_GABIA_AUTH_SECRET= (32+ bytes, supply securely, never commit)
# Production worker stays disabled until separately authorized.
