{
  "rewrites": [
    {
      "source": "/admin/skynet-jobs",
      "destination": "/api/skynet-jobs"
    },
    {
      "source": "/admin/skynet-tool-run",
      "destination": "/api/skynet-tool-run"
    },
    {
      "source": "/admin/skynet-chat",
      "destination": "/api/skynet-chat"
    },
    {
      "source": "/admin/skynet-archive",
      "destination": "/api/skynet-archive"
    },
    {
      "source": "/admin/skynet-memory",
      "destination": "/api/skynet-memory"
    },
    {
      "source": "/admin/skynet-document",
      "destination": "/api/skynet-document"
    },
    {
      "source": "/admin/skynet-index-backfill",
      "destination": "/api/skynet-index-backfill"
    },
    {
      "source": "/admin/skynet-timeline",
      "destination": "/api/skynet-timeline"
    },
    {
      "source": "/admin/skynet-data-admin",
      "destination": "/api/skynet-data-admin"
    }
  ],
  "installCommand": "npm install --ignore-scripts --no-audit --no-fund && node --test tests/*.test.mjs && node scripts/customer-db-migrate.mjs",
  "crons": [
    {
      "path": "/api/customer-analysis-worker",
      "schedule": "*/5 * * * *"
    }
  ]
}
